    {
      "id": "E4VRjiQZ4PPZB0yeN9hhw",
      "type": "text",
      "x": 765.3024525302877,
      "y": -54.054996974260405,
      "width": 217.69867428254747,
      "height": 200,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 70,
      "groupIds": [],
      "frameId": null,
      "index": "aM",
      "roundness": null,
      "seed": 1692262082,
      "version": 358,
      "versionNonce": 496844318,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "I2sHbG_FNNI8TTUXLAK3Q",
          "type": "arrow"
        }
      ],
      "updated": 1770123303270,
      "link": null,
      "locked": false,
      "text": "This API is gpu specefic\nand is generally not public\nand can be reverse\ningeneered  (just a set of\ncustom Assembly\ncommands).\nThis is the interface the\nKernel/User-Space driver\nuses to talk to the GPU's\nfirmware.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "This API is gpu specefic and is generally not public and can be reverse ingeneered  (just a set of custom Assembly commands).\nThis is the interface the Kernel/User-Space driver uses to talk to the GPU's firmware.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "Wtk00e6NFlny-d5EvT8tM",
      "type": "arrow",
      "x": 1709.321660377576,
      "y": 553.5618017052673,
      "width": 225.7223010076334,
      "height": 17.864020054465982,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 70,
      "groupIds": [],
      "frameId": null,
      "index": "aN",
      "roundness": {
        "type": 2
      },
      "seed": 2014142046,
      "version": 444,
      "versionNonce": 1954802434,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1770127348844,
      "link": null,
      "locked": false,
      "points": [
        [
          0,
