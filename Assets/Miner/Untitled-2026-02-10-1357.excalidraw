    {
      "id": "HqKdgxczY4X9NqT-a0e3a",
      "type": "text",
      "x": 1234.6135666728976,
      "y": 485.11149195342693,
      "width": 206.79280257649899,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
