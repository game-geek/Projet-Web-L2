    {
      "id": "1m28J7mpktdyA0nOMIQz9",
      "type": "text",
      "x": 1719.8216603775763,
      "y": 534.2944264105249,
      "width": 383.5165748643128,
      "height": 140,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 70,
      "groupIds": [],
      "frameId": null,
      "index": "aP",
      "roundness": null,
      "seed": 566547294,
      "version": 866,
      "versionNonce": 1578430594,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "Wtk00e6NFlny-d5EvT8tM",
          "type": "arrow"
        }
      ],
      "updated": 1770124296953,
      "link": null,
      "locked": false,
      "text": "GPU model specefic API. It decouples the\n\"stable\" 1st API from the chaotic, ever-changing\nhardware. It allows the same driver command\n\"Draw Triangle\" to work on an RTX 3080 and\n4090, even if the chips work differently inside.\n It hides the true hardware implementation.\nVirtually impossible to reverse engeneer.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "GPU model specefic API. It decouples the \"stable\" 1st API from the chaotic, ever-changing hardware. It allows the same driver command \"Draw Triangle\" to work on an RTX 3080 and 4090, even if the chips work differently inside.\n It hides the true hardware implementation. Virtually impossible to reverse engeneer.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "kW-pOCzzQXuz6YRPSSkyl",
      "type": "rectangle",
