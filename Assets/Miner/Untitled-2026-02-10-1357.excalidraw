        "QhqS25bk9awoWRZulMGrt"
      ],
      "frameId": null,
      "index": "aVG",
      "roundness": null,
      "seed": 64197342,
      "version": 396,
      "versionNonce": 1782942658,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "hZ2Qm5Z6oxh7u6JIU0KZy",
          "type": "arrow"
        }
      ],
      "updated": 1770125128140,
      "link": null,
      "locked": false,
      "text": " Command Processor\n(runs the Firmware )",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": " Command Processor (runs the Firmware )",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "5YaI8ckewYAXOk7X4yIeE",
      "type": "text",
      "x": 1178.8978472408355,
      "y": 551.1452744445846,
      "width": 319.34003455276195,
      "height": 140,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "QhqS25bk9awoWRZulMGrt"
      ],
      "frameId": null,
      "index": "aVV",
      "roundness": null,
      "seed": 1793116866,
      "version": 566,
      "versionNonce": 557955074,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "Wtk00e6NFlny-d5EvT8tM",
          "type": "arrow"
        }
      ],
      "updated": 1770127351965,
      "link": null,
      "locked": false,
      "text": "The firmware reads the 1st API (Ring\nBuffer) and translates it into internal\nsignals (Assembly instructions that get\nexecuted on the GPU cores: Micro-Ops\nAPI) to drive the hardware.\nAlso handles multitasking in the same\nway the OS does.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The firmware reads the 1st API (Ring Buffer) and translates it into internal signals (Assembly instructions that get executed on the GPU cores: Micro-Ops API) to drive the hardware.\nAlso handles multitasking in the same way the OS does.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "y8ZgxpgtaRcGihNSnwT2a",
      "type": "text",
      "x": 1223.2308160106338,
      "y": 700.2889030519261,
      "width": 207.38976146869825,
      "height": 80,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "QhqS25bk9awoWRZulMGrt"
      ],
      "frameId": null,
      "index": "aVl",
      "roundness": null,
      "seed": 187779010,
      "version": 209,
      "versionNonce": 2128790402,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1770125128140,
      "link": null,
      "locked": false,
      "text": "It also handles complex\nscheduling (power, thermal,\nsecurity) that the main\nOS shouldn't worry about.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "It also handles complex scheduling (power, thermal, security) that the main OS shouldn't worry about.",
      "autoResize": false,
      "lineHeight": 1.25
    },
